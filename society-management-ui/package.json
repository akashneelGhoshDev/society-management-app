{
  "name": "society-management-ui",
  "version": "2.4.0",
  "main": "electron/main.js",
  "description": "This is a app of managing a residential society",
  "author": {
    "name": "Akashneel Ghosh",
    "email": "akashneel.ghosh.enterprises@gmail.com"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start-bn": "ng serve --configuration development-bn",
    "start-hi": "ng serve --configuration development-hi",
    "build": "ng build",
    "build:electron": "ng build --configuration electron",
    "extract-i18n": "ng extract-i18n",
    "desktop": "electron .",
    "dist:electron": "electron-builder",
    "dist:electron:test": "set CSC_IDENTITY_AUTO_DISCOVERY=false && electron-builder --dir",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/cdk": "^22.0.1",
    "@angular/common": "^22.0.1",
    "@angular/compiler": "^22.0.1",
    "@angular/core": "^22.0.1",
    "@angular/forms": "^22.0.1",
    "@angular/material": "^22.0.1",
    "@angular/platform-browser": "^22.0.1",
    "@angular/router": "^22.0.1",
    "@angular/service-worker": "^22.0.1",
    "@supabase/supabase-js": "^2.106.2",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.1",
    "@angular/cli": "^22.0.1",
    "@angular/compiler-cli": "^22.0.1",
    "@angular/localize": "^22.0.1",
    "@tailwindcss/postcss": "^4.1.12",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "vitest": "^4.0.8"
  },
  "build": {
    "appId": "com.ubeslabs.societymanagement",
    "productName": "Society Management",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
